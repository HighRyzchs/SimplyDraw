<UserControl x:Class="SimplyDraw.Controls.ColorStudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="292">
  <Border Background="#1C1916" BorderBrush="#3A342C" BorderThickness="1" CornerRadius="16" Padding="14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.38" Direction="270"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="COLOR" FontSize="11" FontWeight="SemiBold" Foreground="#C4623A"/>
      <Grid Width="220" Height="220" Margin="0,12,0,0" HorizontalAlignment="Center">
        <Image x:Name="WheelImage" MouseLeftButtonDown="WheelDown" MouseMove="WheelMove" MouseLeftButtonUp="WheelUp"/>
        <Ellipse x:Name="Marker" Width="14" Height="14" Stroke="#F6F1E8" StrokeThickness="2" Fill="#33000000"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <TextBlock Text="Brightness" Width="84" VerticalAlignment="Center" Foreground="#A3988C" FontSize="12"/>
        <Slider x:Name="ValueSlider" Minimum="0" Maximum="1" Value="1" Style="{StaticResource ThinSlider}" ValueChanged="ValueChanged"/>
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Hex" Width="84" VerticalAlignment="Center" Foreground="#A3988C" FontSize="12"/>
        <TextBox x:Name="HexBox" Padding="8,4" LostFocus="HexLostFocus" KeyDown="HexKeyDown"
                 Background="#241F1B" Foreground="#F6F1E8" BorderBrush="#3A342C" CaretBrush="#F6F1E8"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Use color" Style="{StaticResource AccentButton}" Click="UseClick"/>
        <Button Content="Add to palette" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="AddClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
