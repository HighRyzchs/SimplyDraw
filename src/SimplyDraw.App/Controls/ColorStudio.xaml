<UserControl x:Class="SimplyDraw.Controls.ColorStudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="292">
  <Border Background="#FFFBF8F3" BorderBrush="#E6DFD3" BorderThickness="1" CornerRadius="16" Padding="14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.16" Direction="270" Color="#3A2E22"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="Color" FontSize="14" FontWeight="SemiBold" Foreground="#1F2430"/>
      <Grid Width="220" Height="220" Margin="0,10,0,0" HorizontalAlignment="Center">
        <Image x:Name="WheelImage" MouseLeftButtonDown="WheelDown" MouseMove="WheelMove" MouseLeftButtonUp="WheelUp"/>
        <Ellipse x:Name="Marker" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="#33000000"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <TextBlock Text="Brightness" Width="84" VerticalAlignment="Center" Foreground="#746C62"/>
        <Slider x:Name="ValueSlider" Minimum="0" Maximum="1" Value="1" Style="{StaticResource ThinSlider}" ValueChanged="ValueChanged"/>
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Hex" Width="84" VerticalAlignment="Center" Foreground="#746C62"/>
        <TextBox x:Name="HexBox" Padding="8,4" LostFocus="HexLostFocus" KeyDown="HexKeyDown"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Use color" Padding="12,6" Click="UseClick" Background="#2F6FED" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        <Button Content="Add to palette" Margin="8,0,0,0" Padding="12,6" Click="AddClick" Cursor="Hand"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
