<Window x:Class="SimplyDraw.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#161310" FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="#F3EDE4">
  <StackPanel Margin="22">
    <TextBlock Text="Export drawing" FontSize="18" FontWeight="SemiBold" Foreground="#F6F1E8"/>
    <TextBlock Text="PNG keeps the paper and brush texture. SVG keeps strokes sharp in other apps." Margin="0,6,0,14" Foreground="#A3988C" TextWrapping="Wrap"/>
    <RadioButton x:Name="ViewOption" Content="Current view" IsChecked="True" Margin="0,0,0,6" Foreground="#F3EDE4"/>
    <RadioButton x:Name="EntireOption" Content="Entire drawing" Margin="0,0,0,12" Foreground="#F3EDE4"/>
    <TextBlock Text="FORMAT" Foreground="#C4623A" FontSize="11" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
      <RadioButton x:Name="PngOption" Content="PNG" IsChecked="True" Margin="0,0,16,0" Foreground="#F3EDE4"/>
      <RadioButton x:Name="SvgOption" Content="SVG" Foreground="#F3EDE4"/>
    </StackPanel>
    <TextBlock Text="PNG SCALE" Foreground="#C4623A" FontSize="11" FontWeight="SemiBold"/>
    <ComboBox x:Name="ScaleBox" Style="{StaticResource ChromeCombo}" Margin="0,8,0,14" SelectedIndex="1">
      <ComboBoxItem Content="1×"/>
      <ComboBoxItem Content="2×"/>
      <ComboBoxItem Content="3×"/>
    </ComboBox>
    <CheckBox x:Name="GridBox" Style="{StaticResource ChromeCheck}" Content="Include grid on PNG" IsChecked="False" Margin="0,0,0,18"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Style="{StaticResource QuietButton}" Width="96" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Export" Style="{StaticResource AccentButton}" Width="96" IsDefault="True" Click="ExportClick"/>
    </StackPanel>
  </StackPanel>
</Window>
