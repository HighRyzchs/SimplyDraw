<Window x:Class="SimplyDraw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:SimplyDraw.Canvas"
        xmlns:controls="clr-namespace:SimplyDraw.Controls"
        Title="SimplyDraw"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3EEE4"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True">
  <Grid>
    <canvas:InfiniteCanvas x:Name="Surface"/>

    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0" Background="#FFFBF8F3"
            BorderBrush="#E6DFD3" BorderThickness="1" CornerRadius="16" Padding="8,6">
      <Border.Effect>
        <StaticResource ResourceKey="FloatShadow"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="LogoButton" Style="{StaticResource TextButton}" Click="LogoClick" ToolTip="File menu">
          <StackPanel Orientation="Horizontal">
            <Border Width="22" Height="22" CornerRadius="7" Background="#2F6FED" Margin="0,0,8,0">
              <Path Data="M6,15 C8,9 14,8 16,12" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <TextBlock Text="SimplyDraw" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1F2430"/>
          </StackPanel>
        </Button>
        <Border Width="1" Background="#E6DFD3" Margin="8,6"/>
        <Button x:Name="NewButton" Style="{StaticResource IconButton}" Click="NewClick" ToolTip="New (Ctrl+N)"/>
        <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Click="OpenClick" ToolTip="Open (Ctrl+O)"/>
        <Button x:Name="SaveButton" Style="{StaticResource IconButton}" Click="SaveClick" ToolTip="Save (Ctrl+S)"/>
        <Border Width="1" Background="#E6DFD3" Margin="8,6"/>
        <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="UndoClick" ToolTip="Undo (Ctrl+Z)"/>
        <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="RedoClick" ToolTip="Redo (Ctrl+Y)"/>
        <Border Width="1" Background="#E6DFD3" Margin="8,6"/>
        <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" Click="ZoomOutClick" ToolTip="Zoom out"/>
        <TextBlock x:Name="ZoomLabel" Width="58" Text="100%" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#1F2430"/>
        <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" Click="ZoomInClick" ToolTip="Zoom in"/>
        <Button x:Name="FitButton" Style="{StaticResource IconButton}" Click="FitClick" ToolTip="Fit drawing (Ctrl+1)"/>
        <Border Width="1" Background="#E6DFD3" Margin="8,6"/>
        <TextBlock Text="Touch" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="#746C62"/>
        <ToggleButton x:Name="TouchMoveButton" Content="Move" Style="{StaticResource ToolToggle}" Width="58" Click="TouchMoveClick" ToolTip="One finger moves the page"/>
        <ToggleButton x:Name="TouchSelectButton" Content="Select" Style="{StaticResource ToolToggle}" Width="64" Margin="4,0,0,0" Click="TouchSelectClick" ToolTip="One finger selects marks"/>
        <Border Width="1" Background="#E6DFD3" Margin="8,6"/>
        <Button x:Name="ViewButton" Style="{StaticResource TextButton}" Content="View" Click="ViewClick" ToolTip="Paper, grid, and snap"/>
        <Button x:Name="ExportButton" Style="{StaticResource TextButton}" Content="Export" Margin="4,0,0,0" Click="ExportClick" ToolTip="Export PNG or SVG (Ctrl+E)"/>
      </StackPanel>
    </Border>

    <Border x:Name="LayersCard" Width="250" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
            Background="#FFFBF8F3" BorderBrush="#E6DFD3" BorderThickness="1" CornerRadius="16" Padding="12">
      <Border.Effect>
        <StaticResource ResourceKey="FloatShadow"/>
      </Border.Effect>
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="Layers" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1F2430"/>
          <Button x:Name="CloseLayersButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="CloseLayersClick" ToolTip="Hide layers"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Opacity" Foreground="#746C62" VerticalAlignment="Center" Width="58"/>
            <Slider x:Name="LayerOpacity" Style="{StaticResource ThinSlider}" Minimum="0.05" Maximum="1" Value="1"
                    PreviewMouseLeftButtonDown="LayerOpacityDown" PreviewMouseLeftButtonUp="LayerOpacityUp" ValueChanged="LayerOpacityChanged"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddLayerButton" Style="{StaticResource IconButton}" Click="AddLayerClick" ToolTip="Add layer"/>
            <Button x:Name="DuplicateLayerButton" Style="{StaticResource IconButton}" Click="DuplicateLayerClick" ToolTip="Duplicate layer"/>
            <Button x:Name="UpLayerButton" Style="{StaticResource IconButton}" Click="UpLayerClick" ToolTip="Move layer up"/>
            <Button x:Name="DownLayerButton" Style="{StaticResource IconButton}" Click="DownLayerClick" ToolTip="Move layer down"/>
            <Button x:Name="DeleteLayerButton" Style="{StaticResource IconButton}" Click="DeleteLayerClick" ToolTip="Delete layer"/>
          </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
          <StackPanel x:Name="LayerRows"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Button x:Name="LayersToggle" Content="Layers" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
            Visibility="Collapsed" Padding="12,10" Background="#FFFBF8F3" BorderBrush="#E6DFD3" BorderThickness="1"
            Cursor="Hand" Click="ShowLayersClick"/>

    <Border x:Name="HintCard" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,108" MaxWidth="360"
            Background="#FF1F2430" CornerRadius="14" Padding="14">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="White" FontSize="13" LineHeight="18"
                   Text="The pen uses the tool you picked. One finger moves the page, and a pinch zooms. Switch Touch to Select when you want a finger to select marks instead. Right-drag or hold Space to pan with a mouse."/>
        <Button Content="Got it" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="12,4" Click="DismissHintClick"
                Background="#2F6FED" Foreground="White" BorderThickness="0" Cursor="Hand"/>
      </StackPanel>
    </Border>

    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,16" Background="#FFFBF8F3"
            BorderBrush="#E6DFD3" BorderThickness="1" CornerRadius="18" Padding="8">
      <Border.Effect>
        <StaticResource ResourceKey="FloatShadow"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <StackPanel x:Name="ToolHost" Orientation="Horizontal"/>
        <Border Width="1" Background="#E6DFD3" Margin="8,6"/>
        <StackPanel x:Name="DrawOptions" Orientation="Horizontal">
          <Button x:Name="BrushButton" Style="{StaticResource TextButton}" Click="BrushClick" ToolTip="Brushes" MinWidth="108"/>
          <Slider x:Name="SizeSlider" Width="120" Style="{StaticResource ThinSlider}" ValueChanged="BrushSizeChanged"/>
          <TextBlock x:Name="SizeLabel" Width="52" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="#1F2430"/>
          <Slider x:Name="OpacitySlider" Width="90" Style="{StaticResource ThinSlider}" Minimum="0.05" Maximum="1" ValueChanged="OpacityChanged"/>
          <TextBlock x:Name="OpacityLabel" Width="40" VerticalAlignment="Center" Foreground="#1F2430"/>
        </StackPanel>
        <StackPanel x:Name="EraseOptions" Orientation="Horizontal" Visibility="Collapsed">
          <TextBlock Text="Eraser" VerticalAlignment="Center" Margin="4,0" Foreground="#746C62"/>
          <Slider x:Name="EraserSlider" Width="140" Style="{StaticResource ThinSlider}" Minimum="4" Maximum="120" ValueChanged="EraserChanged"/>
          <ToggleButton x:Name="WholeStrokeToggle" Content="Whole mark" Margin="8,0,0,0" Padding="10,0" Height="36" Click="WholeStrokeClick" ToolTip="Remove an entire mark instead of splitting it"/>
        </StackPanel>
        <StackPanel x:Name="SelectOptions" Orientation="Horizontal" Visibility="Collapsed">
          <ToggleButton x:Name="RectSelectButton" Content="Box" Style="{StaticResource ToolToggle}" Width="52" Click="RectSelectClick"/>
          <ToggleButton x:Name="LassoSelectButton" Content="Lasso" Style="{StaticResource ToolToggle}" Width="64" Margin="4,0,0,0" Click="LassoSelectClick"/>
          <Button x:Name="DuplicateButton" Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="DuplicateClick" ToolTip="Duplicate (Ctrl+D)"/>
          <Button x:Name="DeleteSelectionButton" Style="{StaticResource IconButton}" Click="DeleteSelectionClick" ToolTip="Delete"/>
        </StackPanel>
        <Border Width="1" Background="#E6DFD3" Margin="8,6"/>
        <Button x:Name="ColorButton" Style="{StaticResource IconButton}" Width="44" Height="44" Click="ColorClick" ToolTip="Colors">
          <Ellipse x:Name="ColorOrb" Width="22" Height="22" Stroke="White" StrokeThickness="2"/>
        </Button>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,78"
               Foreground="#8A8175" FontSize="12"/>

    <Popup x:Name="FilePopup" PlacementTarget="{Binding ElementName=LogoButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#FFFBF8F3" BorderBrush="#E6DFD3" BorderThickness="1" CornerRadius="12" Padding="6" MinWidth="220" Margin="0,8,0,0">
        <StackPanel>
          <Button Content="New" Style="{StaticResource MenuButton}" Click="NewClick"/>
          <Button Content="Open…" Style="{StaticResource MenuButton}" Click="OpenClick"/>
          <Button Content="Save" Style="{StaticResource MenuButton}" Click="SaveClick"/>
          <Button Content="Save as…" Style="{StaticResource MenuButton}" Click="SaveAsClick"/>
          <Button Content="Import image…" Style="{StaticResource MenuButton}" Click="ImportClick"/>
          <Button Content="Demo sketch" Style="{StaticResource MenuButton}" Click="DemoClick"/>
          <Separator Margin="4"/>
          <TextBlock Text="Recent" Margin="10,4" Foreground="#746C62" FontSize="12"/>
          <StackPanel x:Name="RecentList"/>
          <Separator Margin="4"/>
          <Button Content="Shortcuts" Style="{StaticResource MenuButton}" Click="ShortcutsClick"/>
          <Button Content="About" Style="{StaticResource MenuButton}" Click="AboutClick"/>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="ViewPopup" PlacementTarget="{Binding ElementName=ViewButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#FFFBF8F3" BorderBrush="#E6DFD3" BorderThickness="1" CornerRadius="12" Padding="14" Width="260" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="Paper" Foreground="#746C62"/>
          <ComboBox x:Name="PaperBox" Margin="0,4,0,10" SelectionChanged="PaperChanged"/>
          <TextBlock Text="Grid" Foreground="#746C62"/>
          <ComboBox x:Name="GridBox" Margin="0,4,0,10" SelectionChanged="GridChanged"/>
          <TextBlock Text="Spacing" Foreground="#746C62"/>
          <Slider x:Name="SpacingSlider" Style="{StaticResource ThinSlider}" Minimum="12" Maximum="96" Margin="0,6,0,10" ValueChanged="SpacingChanged"/>
          <CheckBox x:Name="SnapBox" Content="Snap shapes to the grid" Checked="SnapChanged" Unchecked="SnapChanged"/>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="BrushPopup" PlacementTarget="{Binding ElementName=BrushButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#FFFBF8F3" BorderBrush="#E6DFD3" BorderThickness="1" CornerRadius="14" Padding="10" Width="320" Margin="0,0,0,8">
        <StackPanel>
          <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BrushList"/>
          </ScrollViewer>
          <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Smoothing" Width="84" VerticalAlignment="Center" Foreground="#746C62"/>
            <TextBlock x:Name="SmoothLabel" Width="36" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            <Slider x:Name="SmoothSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="0.92" ValueChanged="SmoothChanged"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
      <Canvas x:Name="ColorFan" Width="440" Height="250"/>
    </Popup>

    <Popup x:Name="StudioPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Left" StaysOpen="False" AllowsTransparency="True">
      <controls:ColorStudio x:Name="Studio" Margin="0,0,12,0"/>
    </Popup>

    <Popup x:Name="TextPopup" PlacementTarget="{Binding ElementName=Surface}" Placement="Relative" StaysOpen="True" AllowsTransparency="True">
      <TextBox x:Name="InlineText" MinWidth="160" MinHeight="36" Padding="6" AcceptsReturn="True" TextWrapping="Wrap"
               BorderBrush="#2F6FED" BorderThickness="1.5" Background="#FFFFFFF2" FontSize="28"
               LostFocus="InlineTextLostFocus" PreviewKeyDown="InlineTextKeyDown"/>
    </Popup>
  </Grid>
</Window>
