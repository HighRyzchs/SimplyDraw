<Window x:Class="SimplyDraw.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcuts" Width="460" Height="640" WindowStartupLocation="CenterOwner"
        Background="#FBF8F3" FontFamily="Segoe UI">
  <ScrollViewer Padding="22">
    <StackPanel>
      <TextBlock Text="Shortcuts" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock TextWrapping="Wrap" Foreground="#746C62" Margin="0,0,0,14"
                 Text="The pen uses the active tool. One finger moves the page, or selects when Touch is set to Select. Two fingers pinch to zoom. Right-drag, middle-drag, or hold Space to pan with a mouse."/>
      <TextBlock x:Name="Body" FontSize="13" LineHeight="22" Foreground="#1F2430"/>
    </StackPanel>
  </ScrollViewer>
</Window>
