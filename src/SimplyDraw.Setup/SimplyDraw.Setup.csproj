<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplyDraw.Setup</RootNamespace>
    <AssemblyName>SimplyDrawSetup</AssemblyName>
    <Version>0.1.1</Version>
    <FileVersion>0.1.1.0</FileVersion>
    <Product>SimplyDraw Setup</Product>
    <Company>SimplyDraw</Company>
    <Description>Installs and updates SimplyDraw from the latest GitHub release.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\SimplyDraw.App\Assets\SimplyDraw.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
